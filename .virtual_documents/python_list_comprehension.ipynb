





squares = [x**2 for x in range(5)]
print(squares)  # Output: [0, 1, 4, 9, 16]


# Same thing with a loop — longer, but equivalent
squares_loop = []
for x in range(5):
    squares_loop.append(x**2)
print(squares_loop)





evens = [x for x in range(10) if x % 2 == 0]
print(evens)  # Output: [0, 2, 4, 6, 8]





numbers = ["Even" if x % 2 == 0 else "Odd" for x in range(5)]
print(numbers)  # Output: ['Even', 'Odd', 'Even', 'Odd', 'Even']





pairs = [(x, y) for x in range(2) for y in range(3)]
print(pairs)  # Output: [(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2)]





words = ["hello", "world", "python"]
upper_words = [word.upper() for word in words]
print(upper_words)  # Output: ['HELLO', 'WORLD', 'PYTHON']





matrix = [[1, 2], [3, 4], [5, 6]]
flattened = [num for row in matrix for num in row]
print(flattened)  # Output: [1, 2, 3, 4, 5, 6]





# Set Comprehension — { } without a key: value pair
unique_numbers = {x for x in [1, 2, 2, 3, 4, 4]}
print(unique_numbers)  # Output: {1, 2, 3, 4}


# Dictionary Comprehension — {key: value for ...}
squared_dict = {x: x**2 for x in range(5)}
print(squared_dict)  # Output: {0: 0, 1: 1, 2: 4, 3: 9, 4: 16}





gen = (x**2 for x in range(3))
print(type(gen))        # <class 'generator'> — lazy, single-use!
print(list(gen))        # [0, 1, 4]
print(list(gen))        # [] — already exhausted

real_tuple = tuple(x**2 for x in range(3))
print(real_tuple)       # (0, 1, 4)








import time

# Using a for loop
start = time.time()
squares_loop = []
for x in range(10**6):
    squares_loop.append(x**2)
print("Loop time:", time.time() - start)

# Using list comprehension
start = time.time()
squares_comp = [x**2 for x in range(10**6)]
print("List Comprehension time:", time.time() - start)





students = [("Alice", 85), ("Bob", 40), ("Charlie", 75), ("Diana", 55)]

# Extract names of passing students
passing = [name for name, score in students if score >= 50]
print(passing)  # ['Alice', 'Charlie', 'Diana']

# Map names to pass/fail labels
results = [(name, "Pass" if score >= 50 else "Fail") for name, score in students]
print(results)



