





square = lambda x: x ** 2
print(square(5))  # Output: 25


# Lambda vs. def — the equivalent named function
def square_def(x):
    return x ** 2

print(square_def(5))  # Same result: 25





numbers = [1, 2, 3, 4]
squared = list(map(lambda x: x**2, numbers))
print(squared)  # Output: [1, 4, 9, 16]


# Note: a list comprehension is usually preferred over map + lambda
squared = [x**2 for x in numbers]
print(squared)  # Same result, more Pythonic





numbers = [1, 2, 3, 4, 5, 6]
evens = list(filter(lambda x: x % 2 == 0, numbers))
print(evens)  # Output: [2, 4, 6]

# Equivalent list comprehension
evens = [x for x in numbers if x % 2 == 0]
print(evens)





from functools import reduce

numbers = [1, 2, 3, 4]
product = reduce(lambda x, y: x * y, numbers)
print(product)  # Output: 24


# How reduce works step by step with lambda x, y: x * y
# ((1 * 2) * 3) * 4 = 24
print(reduce(lambda x, y: x + y, numbers))   # Sum → 10
print(reduce(lambda x, y: max(x, y), numbers))  # Max → 4





# Example: Adding two numbers
add = lambda x, y: x + y
print(add(3, 7))  # Output: 10

# Example: Finding the maximum of two numbers
maximum = lambda x, y: x if x > y else y
print(maximum(10, 5))  # Output: 10





students = [("Alice", 85), ("Bob", 78), ("Charlie", 92)]

students.sort(key=lambda student: student[1])  # Sort by score
print(students)  # Output: [('Bob', 78), ('Alice', 85), ('Charlie', 92)]

# sorted() returns a NEW list, original stays unchanged
by_name = sorted(students, key=lambda s: s[0])
print(by_name)





# ❌ These would raise SyntaxError:
# f = lambda x: y = x + 1        # assignment is a statement, not expression
# g = lambda x: print(x); return x  # multiple statements

# ✅ Conditional EXPRESSIONS are allowed (if-else as an expression):
label = lambda x: "positive" if x > 0 else "non-positive"
print(label(5))





import pandas as pd

df = pd.DataFrame({'Name': ['Alice', 'Bob', 'Charlie'], 'Score': [85, 40, 75]})

# Categorize scores with a lambda
df['Grade'] = df['Score'].apply(lambda s: 'A' if s >= 80 else 'B' if s >= 60 else 'C' if s >= 40 else 'F')

# Normalize a column with a lambda
df['Normalized'] = df['Score'].apply(lambda s: round(s / 100, 2))

print(df)



