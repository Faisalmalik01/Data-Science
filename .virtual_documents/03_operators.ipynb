





# Store two numbers in variables.
a = 10
b = 5

# Perform each arithmetic operation.
print(a + b)   # Addition: 15
print(a - b)   # Subtraction: 5
print(a * b)   # Multiplication: 50
print(a / b)   # Division: 2.0
print(a // b)  # Floor division: 2
print(a % b)   # Remainder: 0
print(a ** b)  # 10 raised to the power 5: 100000





number = 17

# The remainder after dividing 17 by 2 is 1, so 17 is odd.
print(number % 2)  # 1

# Floor division tells us how many whole groups of 2 fit into 17.
print(number // 2)  # 8

# Negative-number example: floor division rounds down.
print(-7 // 2)  # -4





a = 10
b = 5

print(a == b)  # False: 10 is not equal to 5
print(a != b)  # True: 10 is not equal to 5
print(a > b)   # True
print(a < b)   # False
print(a >= 10) # True: equal to 10 is enough
print(b <= 5)  # True: equal to 5 is enough





score = 85

# Check whether score is between 0 and 100, inclusive.
print(0 <= score <= 100)  # True





x = True
y = False

print(x and y)  # False: both are not True
print(x or y)   # True: at least one is True
print(not x)    # False: not True is False
print(not y)    # True: not False is True





age = 20
has_ticket = True

# Both conditions must be true.
print(age >= 18 and has_ticket)  # True

# Either condition can be true for this expression to be True.
print(age < 18 or has_ticket)    # True








a = 5  # Binary: 0101
b = 3  # Binary: 0011

print(a & b)   # AND: 1  (0001)
print(a | b)   # OR: 7   (0111)
print(a ^ b)   # XOR: 6  (0110); bits differ
print(~a)      # NOT: -6 in Python's signed-integer model
print(a << 1) # Left shift: 10
print(a >> 1) # Right shift: 2








a = 10
a += 5
print(a)  # 15

a -= 3
print(a)  # 12

a *= 2
print(a)  # 24

a /= 4
print(a)  # 6.0

a //= 4
print(a)  # 1.0

a %= 2
print(a)  # 1.0

a **= 3
print(a)  # 1.0





count = 7
count /= 2

print(count)       # 3.5
print(type(count)) # <class 'float'>





numbers = [1, 2, 3]
x = 2

print(x in numbers)       # True
print(4 not in numbers)   # True
print("Py" in "Python")   # True
print("py" in "Python")   # False: case-sensitive





a = [1, 2, 3]
b = [1, 2, 3]
c = a

# a and b contain equal values, but are separate list objects.
print(a == b)  # True: values are equal
print(a is b)  # False: not the same object

# c refers to the very same object as a.
print(a is c)  # True

# None is a special value; identity checks are conventional here.
result = None
print(result is None)  # True








# Multiplication happens before addition.
print(2 + 3 * 4)    # 14

# Parentheses make addition happen first.
print((2 + 3) * 4)  # 20

# Exponentiation happens before multiplication.
print(2 * 3 ** 2)   # 18





