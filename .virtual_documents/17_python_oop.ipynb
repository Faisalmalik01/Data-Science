








class Car:
    def __init__(self, brand, model):
        self.brand = brand  # Attribute
        self.model = model  # Attribute

    def display_info(self):  # Method
        return f"{self.brand} {self.model}"

# Creating an Object (Instance)
car1 = Car("Toyota", "Camry")
print(car1.display_info())  # Output: Toyota Camry


# Class attribute vs. instance attribute
class Car:
    wheels = 4                      # Class attribute — shared by ALL cars
    def __init__(self, brand):
        self.brand = brand          # Instance attribute — unique per car

a, b = Car("Toyota"), Car("Honda")
print(a.wheels, b.wheels)   # 4 4 — shared
a.wheels = 6                  # Creating an instance-level shadow
print(a.wheels, b.wheels)   # 6 4 — b still uses the class attribute





class BankAccount:
    def __init__(self, balance):
        self.__balance = balance      # Private attribute

    def get_balance(self):            # Getter
        return self.__balance

    def deposit(self, amount):        # Setter logic
        if amount > 0:
            self.__balance += amount

# Using Encapsulation
account = BankAccount(1000)
account.deposit(500)
print(account.get_balance())  # Output: 1500

# print(account.__balance)     # ❌ AttributeError
# (Technically accessible via account._BankAccount__balance — name mangling!)





class Animal:
    def speak(self):
        return "Animal makes a sound"

class Dog(Animal):  # Inheriting from Animal
    def speak(self):
        return "Bark"

dog = Dog()
print(dog.speak())  # Output: Bark


# super() — call the parent's method instead of fully replacing it
class Animal:
    def __init__(self, name):
        self.name = name

    def speak(self):
        return "Some sound"

class Dog(Animal):
    def __init__(self, name, breed):
        super().__init__(name)   # Reuse parent's constructor
        self.breed = breed

    def speak(self):
        return super().speak() + " → Bark!"  # Extend parent's behavior

d = Dog("Rex", "Labrador")
print(d.name, d.breed)
print(d.speak())





class A:
    def method_a(self):
        return "Method A"

class B:
    def method_b(self):
        return "Method B"

class C(A, B):  # Multiple inheritance
    pass

obj = C()
print(obj.method_a())  # Output: Method A
print(obj.method_b())  # Output: Method B

# Method Resolution Order — the order Python searches parent classes
print(C.__mro__)





class Bird:
    def fly(self):
        return "Birds can fly"

class Penguin(Bird):
    def fly(self):
        return "Penguins cannot fly"

bird = Bird()
penguin = Penguin()
print(bird.fly())     # Output: Birds can fly
print(penguin.fly())  # Output: Penguins cannot fly


# Polymorphism in action: one loop, many behaviors
animals = [Bird(), Penguin()]
for a in animals:
    print(a.fly())





from abc import ABC, abstractmethod

class Shape(ABC):
    @abstractmethod
    def area(self):
        pass  # No implementation — must be defined by child classes

class Square(Shape):
    def __init__(self, side):
        self.side = side

    def area(self):
        return self.side * self.side  # Implemented in child class

square = Square(4)
print(square.area())  # Output: 16

# shape = Shape()   # ❌ TypeError: Can't instantiate abstract class





class Book:
    def __init__(self, title, pages):
        self.title = title
        self.pages = pages

    def __str__(self):            # String representation
        return f"Book: {self.title}"

    def __len__(self):            # Define behavior for len()
        return self.pages

book = Book("Python Basics", 300)
print(str(book))  # Output: Book: Python Basics
print(len(book))  # Output: 300


# More useful dunder methods
class Book:
    def __init__(self, title, pages):
        self.title, self.pages = title, pages

    def __eq__(self, other):   # book1 == book2
        return self.pages == other.pages

    def __add__(self, other):  # book1 + book2
        return self.pages + other.pages

b1, b2 = Book("A", 100), Book("B", 150)
print(b1 == b2)   # False
print(b1 + b2)    # 250 — combined pages





class Example:
    class_var = "I am a class variable"

    def instance_method(self):
        return "Instance Method"

    @classmethod
    def class_method(cls):
        return cls.class_var

    @staticmethod
    def static_method():
        return "Static Method"

obj = Example()
print(obj.instance_method())   # Output: Instance Method
print(Example.class_method())  # Output: I am a class variable
print(Example.static_method()) # Output: Static Method





dog = Dog("Rex", "Labrador")
print(isinstance(dog, Dog))     # True — exact type
print(isinstance(dog, Animal))  # True — inherited type too!



